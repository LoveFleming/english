  { "id": "q4-013", "question": "找出錯誤：They buyed souvenirs at the market. 錯誤在哪裡？", "options": ["buyed → bought", "at → in", "沒有錯誤", "souvenirs → souvenir"], "answer": "buyed → bought", "explanation": "buy 的過去式是 bought" },
  { "id": "q4-014", "question": "找出錯誤：He waked up at 6 AM. 錯誤在哪裡？", "options": ["waked → woke", "up → down", "at → on", "沒有錯誤"], "answer": "waked → woke", "explanation": "wake 的過去式是 woke" },
  { "id": "q4-015", "question": "找出錯誤：The glass breaked into pieces. 錯誤在哪裡？", "options": ["breaked → broke", "into → to", "沒有錯誤", "glass → glasses"], "answer": "breaked → broke", "explanation": "break 的過去式是 broke" },

  { "id": "q5-001", "question": "下列哪個動詞的過去式是三態同形（原形=過去式）？", "options": ["go", "hit", "eat", "see"], "answer": "hit", "explanation": "hit 的三態都是 hit，是三態同形動詞" },
  { "id": "q5-002", "question": "下列哪組動詞的過去式都以 -ought 結尾？", "options": ["buy, bring, think", "go, come, see", "hit, put, set", "eat, drink, sleep"], "answer": "buy, bring, think", "explanation": "buy→bought, bring→brought, think→thought，都以 -ought 結尾" },
  { "id": "q5-003", "question": "「她昨天給了我一本書」的正確英文是？", "options": ["She gived me a book yesterday.", "She gave me a book yesterday.", "She gives me a book yesterday.", "She given me a book yesterday."], "answer": "She gave me a book yesterday.", "explanation": "give 的過去式是 gave，昨天要用過去式" },
  { "id": "q5-004", "question": "哪個句子是正確的？", "options": ["He was a doctor last year.", "He were a doctor last year.", "He is a doctor last year.", "He been a doctor last year."], "answer": "He was a doctor last year.", "explanation": "He 搭配 was（is 的過去式），且 last year 要用過去式" },
  { "id": "q5-005", "question": "「我上週去了台北」哪個翻譯正確？", "options": ["I goed to Taipei last week.", "I went to Taipei last week.", "I go to Taipei last week.", "I gone to Taipei last week."], "answer": "I went to Taipei last week.", "explanation": "go 的過去式是 went" },
  { "id": "q5-006", "question": "哪個動詞的過去式改變了母音（元音）？", "options": ["hit → hit", "put → put", "begin → began", "set → set"], "answer": "begin → began", "explanation": "begin→began 改變了母音（i→a），其他三個是三態同形" },
  { "id": "q5-007", "question": "___ you at the party last night?（填入正確的 be 動詞過去式）", "options": ["Was", "Were", "Are", "Is"], "answer": "Were", "explanation": "You 搭配 were" },
  { "id": "q5-008", "question": "She ___ she was tired.（say 的過去式）", "options": ["sayed", "said", "says", "saying"], "answer": "said", "explanation": "say 的過去式是 said" },
  { "id": "q5-009", "question": "下列哪個是不規則動詞？", "options": ["walk", "talk", "come", "play"], "answer": "come", "explanation": "come 的過去式是 came（不規則），其他加 -ed" },
  { "id": "q5-010", "question": "「他們前天沒有做功課」哪個正確？", "options": ["They didn't did their homework.", "They didn't do their homework.", "They don't did their homework.", "They didn't does their homework."], "answer": "They didn't do their homework.", "explanation": "否定句用 didn't + 原形 do，不是 didn't did" },
  { "id": "q5-011", "question": "read 的過去式拼法和現在式一樣，但讀音是？", "options": ["[riːd]", "[rɛd]", "[reɪd]", "[raɪd]"], "answer": "[rɛd]", "explanation": "read 過去式讀 [rɛd]，跟 now 的母音不同" },
  { "id": "q5-012", "question": "___ he come to school yesterday?（填入正確的助動詞）", "options": ["Does", "Do", "Did", "Is"], "answer": "Did", "explanation": "yesterday 是過去式時間，疑問句用 Did 開頭" },
  { "id": "q5-013", "question": "下列哪個過去式是正確的？ lead 的過去式", "options": ["leaded", "led", "lead", "leadt"], "answer": "led", "explanation": "lead 的過去式是 led" },
  { "id": "q5-014", "question": "I ___ a strange noise last night.（hear 的過去式不在本課範圍，但以下哪個是正確用法？）", "options": ["hear", "heard", "heared", "hearing"], "answer": "heard", "explanation": "hear 的過去式是 heard（不規則變化）" },
